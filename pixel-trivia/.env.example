# Google Apps Script Web App 部署網址（用於連接 Google Sheets 存取題目與紀錄分數）
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# DiceBear API 基礎網址（用於生成像素風格頭像，預設可留空或使用官方預設值）
VITE_DICEBEAR_API_URL=https://api.dicebear.com/7.x/pixel-art/svg

# 遊戲基本設定（可選）
VITE_GAME_MAX_QUESTIONS=10
VITE_GAME_TIME_LIMIT_SECONDS=30
